{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchbay:protocol:v1:plugin-progress-params",
  "title": "Patchbay Plugin Progress",
  "type": "object",
  "required": ["execution_id", "progress"],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "additionalProperties": false
}
