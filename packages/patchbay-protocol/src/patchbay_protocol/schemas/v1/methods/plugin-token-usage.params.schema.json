{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchbay:protocol:v1:plugin-token-usage-params",
  "title": "Patchbay AI Token Usage Event",
  "type": "object",
  "required": [
    "execution_id",
    "event_type",
    "data"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "const": "token_usage"
    },
    "data": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
